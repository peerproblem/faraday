 /* MapView — map chrome restyled with SW3 tokens. */
-.sw-map { --sw-map-control-inset: var(--sw-space-3); position: relative; isolation: isolate; overflow: hidden; }
+.sw-map {
+  --sw-map-control-inset: var(--sw-space-3);
+  --sw-map-control-size: var(--sw-space-10);
+  --sw-map-control-bg: light-dark(var(--sw-background), var(--sw-muted));
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+}
 .sw-map__canvas { position: absolute !important; inset: 0; container-type: inline-size; }
 .sw-map .maplibregl-canvas:focus-visible { outline: 2px solid var(--sw-accent); outline-offset: -3px; }
 .sw-map__overlay { --sw-inset: var(--sw-map-control-inset); position: absolute; top: var(--sw-inset); left: var(--sw-inset); z-index: 2; pointer-events: auto; }
+.sw-map__controls {
+  --sw-button-secondary-bg: var(--sw-map-control-bg);
+  position: absolute;
+  top: var(--sw-map-control-inset);
+  right: var(--sw-map-control-inset);
+  z-index: 2;
+  display: grid;
+  gap: var(--sw-space-2);
+  justify-items: end;
+}
+.sw-map__controls[data-after-zoom] { top: calc(var(--sw-map-control-inset) + 2 * var(--sw-map-control-size) + var(--sw-space-2)); }
 /* Control group: sm squircle radius + 1px frame, no shadow (same recipe as every other framed control). */
 .sw-map .maplibregl-ctrl-group { border: 1px solid var(--sw-frame); border-radius: var(--sw-radius-sm); corner-shape: var(--sw-corner-shape); overflow: hidden; box-shadow: none; background: var(--sw-background); }
 .sw-map .maplibregl-ctrl-group:not(:empty) { box-shadow: none; }
