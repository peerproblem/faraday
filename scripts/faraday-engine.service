[Unit]
Description=Faraday engine (API, board builder, live update worker)
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
User=faraday
Group=faraday
WorkingDirectory=/opt/faraday/app/server
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/faraday

[Install]
WantedBy=multi-user.target
