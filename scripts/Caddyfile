# Web server on the Vultr box.
#   api.faraday.watch      -> engine (127.0.0.1:4000)
#   <slug>.faraday.watch   -> board hosting (127.0.0.1:3000), one certificate per board,
#                             issued on first visit and only for boards that exist.
# faraday.watch and www stay on Vercel.
{
	on_demand_tls {
		ask http://127.0.0.1:4000/internal/tls
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

api.faraday.watch {
	# On demand too: Caddy skips names covered by the wildcard site below.
	tls {
		on_demand
	}
	import security
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:4000 {
		flush_interval -1
	}
}

*.faraday.watch {
	tls {
		on_demand
	}
	import security
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
