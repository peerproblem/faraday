{
  "name": "faraday-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash ../scripts/dev-engine.sh",
    "start:api": "tsx --env-file-if-exists=../.env src/api.ts",
    "start:worker": "tsx --env-file-if-exists=../.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env node_modules/vitest/vitest.mjs run",
    "eval": "tsx --env-file-if-exists=../.env src/eval/run.ts",
    "smoke": "tsx --env-file-if-exists=../.env src/scripts/smoke.ts",
    "smoke:decide": "tsx --env-file-if-exists=../.env src/scripts/smoke-decide.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "rebuild-v1": "tsx --env-file-if-exists=../.env src/scripts/rebuild-v1.ts",
    "recompose": "tsx --env-file-if-exists=../.env src/scripts/recompose.ts",
    "smoke:x": "tsx --env-file-if-exists=../.env src/scripts/smoke-x.ts",
    "discord:commands": "tsx --env-file-if-exists=../.env src/scripts/discord-commands.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/openai": "^4.0.118",
    "@auth/core": "0.41.3",
    "@hono/node-server": "^2.1.8",
    "ai": "^7.0.173",
    "context.dev": "^3.29.0",
    "hono": "^4.13.18",
    "mariadb": "^3.5.5",
    "nanoid": "^6.0.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
